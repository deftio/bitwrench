{
	"name": "bitwrench",
	"version": "2.1.9",
	"description": "Zero-dependency JavaScript UI library. Describe UI as plain objects (TACO), render to DOM or HTML strings. Theming, components, pub/sub, server-driven UI (bwserve). No build step.",
	"main": "./dist/bitwrench.cjs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/deftio/bitwrench.git"
	},
	"keywords": [
		"javascript",
		"UI",
		"DOM",
		"utilities",
		"components",
		"theming",
		"SSE",
		"server-driven-ui",
		"no-build",
		"embedded"
	],
	"author": "manu a. chatterjee <deftio@deftio.com> (https://deftio.com/)",
	"license": "BSD-2-Clause",
	"bin": {
		"bwcli": "./bin/bwcli.js",
		"bwmcp": "./bin/bwmcp.js"
	},
	"type": "module",
	"module": "./dist/bitwrench.esm.js",
	"exports": {
		".": {
			"types": "./dist/bitwrench.d.ts",
			"import": "./dist/bitwrench.esm.js",
			"require": "./dist/bitwrench.cjs",
			"default": "./dist/bitwrench.umd.js"
		},
		"./lean": {
			"types": "./dist/bitwrench.d.ts",
			"import": "./dist/bitwrench-lean.esm.js",
			"require": "./dist/bitwrench-lean.cjs",
			"default": "./dist/bitwrench-lean.umd.js"
		},
		"./bccl": {
			"types": "./dist/bitwrench.d.ts",
			"import": "./dist/bitwrench-bccl.esm.js",
			"require": "./dist/bitwrench-bccl.cjs",
			"default": "./dist/bitwrench-bccl.umd.js"
		},
		"./bwserve": {
			"types": "./dist/bwserve.d.ts",
			"import": "./dist/bwserve.esm.js",
			"require": "./dist/bwserve.cjs"
		},
		"./util-css": {
			"import": "./dist/bitwrench-util-css.esm.js",
			"require": "./dist/bitwrench-util-css.cjs",
			"default": "./dist/bitwrench-util-css.umd.js"
		},
		"./code-edit": {
			"import": "./dist/bitwrench-code-edit.esm.js",
			"require": "./dist/bitwrench-code-edit.cjs",
			"default": "./dist/bitwrench-code-edit.umd.js"
		},
		"./debug": {
			"require": "./dist/bitwrench-debug.cjs",
			"default": "./dist/bitwrench-debug.js"
		},
		"./mcp": {
			"import": "./src/mcp/server.js"
		}
	},
	"types": "./dist/bitwrench.d.ts",
	"files": [
		"dist/*.js",
		"dist/*.js.gz",
		"dist/*.cjs",
		"dist/*.cjs.gz",
		"dist/*.css",
		"dist/*.json",
		"dist/*.d.ts",
		"bin/",
		"src/",
		"docs/",
		"README.md",
		"LICENSE.txt"
	],
	"bugs": {
		"url": "https://github.com/deftio/bitwrench/issues"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.27.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@rollup/plugin-babel": "^7.1.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"c8": "^12.0.0",
		"comment-parser": "^1.4.6",
		"eslint": "^10.11.0",
		"globals": "^17.4.0",
		"jsdom": "^26.1.0",
		"jsdom-global": "3.0.2",
		"mocha": "^12.0.2",
		"pixelmatch": "^7.1.0",
		"pngjs": "^7.0.0",
		"rollup": "^4.63.3",
		"rollup-plugin-css-only": "^4.5.2",
		"rollup-plugin-postcss": "^4.0.2",
		"uglify-js": "^3.19.3",
		"uglifyjs": "^2.4.11"
	},
	"scripts": {
		"prepare": "cp tools/hooks/pre-push .git/hooks/pre-push 2>/dev/null && chmod +x .git/hooks/pre-push 2>/dev/null || true",
		"generate-version": "node tools/generate-version.cjs",
		"prebuild": "npm run generate-version && npm run lint",
		"build": "rollup --config && npm run build:css && npm run build:types && npm run build:metrics && npm run build:builds",
		"build:types": "cp src/bitwrench.d.ts dist/bitwrench.d.ts && cp src/bwserve.d.ts dist/bwserve.d.ts",
		"build:css": "node src/generate-css.js",
		"build:readme": "node tools/build-readme.js",
		"build:watch": "rollup --config --watch",
		"update_rm": "echo 'DEPRECATED: use build:index instead'",
		"cleanbuild": "npm run clean && npm run build && npm run build:generated",
		"oldtest": "./node_modules/mocha/bin/mocha test/bitwrench_test.js --reporter spec",
		"test": "c8 --reporter=text --reporter=json-summary mocha ./test/bitwrench_ci.js ./test/bitwrench_test_coverage.js ./test/bitwrench_test_pubsub.js ./test/bitwrench_test_theme.js ./test/bitwrench_test_nodemap.js ./test/bitwrench_test_components.js ./test/bitwrench_test_coverage_gaps.js ./test/bitwrench_test_code_edit.js ./test/bitwrench_test_html_page.js ./test/bitwrench_test_util_css.js ./test/bitwrench_test_handle.js ./test/bitwrench_test_debug.js ./test/bitwrench_test_router.js ./test/bitwrench_test_new_apis.js ./test/bitwrench_test_mcp_transport.js ./test/bitwrench_test_mcp_server.js ./test/bitwrench_test_mcp_tools.js ./test/bitwrench_test_mcp_knowledge.js ./test/bitwrench_test_mcp_live.js ./test/bitwrench_test_bwserve.js ./test/bitwrench_test_attach.js ./test/bitwrench_test_serve.js ./test/bitwrench_test_cli.js ./test/bitwrench_test_bccl_contract.js ./test/bitwrench_test_semantic_html.js ./test/bitwrench_test_contract.js ./test/bitwrench_test_contract_live.js ./test/bitwrench_test_html_golden.js ./test/bitwrench_test_util_color.js ./test/bitwrench_test_uuid.js ./test/bitwrench_test_stable.js ./test/bitwrench_test_v2.js ./test/bitwrench_test_invariants.js ./test/bitwrench_test_meta.js ./test/bitwrench_test_doc_examples.js -r jsdom-global/register --exit && npm run test:bundles",
		"posttest": "node tools/drift-lint.js && npm run verify-sri",
		"test:bundles": "mocha ./test/bitwrench_test_bundles.js -r jsdom-global/register --exit",
		"test:bwserve": "mocha ./test/bitwrench_test_bwserve.js -r jsdom-global/register",
		"test:attach": "mocha ./test/bitwrench_test_attach.js -r jsdom-global/register",
		"test:serve": "mocha ./test/bitwrench_test_serve.js -r jsdom-global/register --exit",
		"test:components": "mocha ./test/bitwrench_test_components.js -r jsdom-global/register",
		"test:pending": "mocha ./test/bitwrench_test_pending.js -r jsdom-global/",
		"test:all-unit": "c8 --reporter=text mocha './test/bitwrench_test*.js' -r jsdom-global/",
		"clean": "rm -rf dist/* bitwrench*.tgz",
		"lint": "./node_modules/.bin/eslint src/",
		"lint:drift": "node tools/drift-lint.js",
		"review:northstar": "node tools/northstar-llm/cli.js",
		"postbuild": "npm run lint:drift && npm run sri",
		"serve": "node server.js",
		"dev": "npm run build && npm run serve",
		"instrument-bw": "echo 'deprecated: use c8 instead'",
		"generate-sri": "node tools/generate-sri.js",
		"test:nodemap": "mocha ./test/bitwrench_test_nodemap.js -r jsdom-global/register",
		"test:cli": "mocha ./test/bitwrench_test_cli.js",
		"test:debug": "mocha ./test/bitwrench_test_debug.js -r jsdom-global/register",
		"test:router": "mocha ./test/bitwrench_test_router.js -r jsdom-global/register",
		"test:code-edit": "mocha ./test/bitwrench_test_code_edit.js -r jsdom-global/register",
		"test:html-page": "mocha ./test/bitwrench_test_html_page.js -r jsdom-global/register",
		"test:mcp": "mocha ./test/bitwrench_test_mcp_transport.js ./test/bitwrench_test_mcp_server.js ./test/bitwrench_test_mcp_tools.js ./test/bitwrench_test_mcp_knowledge.js -r jsdom-global/register --exit",
		"test:mcp:e2e": "mocha ./test/bitwrench_test_mcp_e2e.js --exit --timeout 15000",
		"test:spec21": "mocha \"dev/test_v2.1/*.spec.js\" -r jsdom-global/register --exit",
		"test:e2e": "playwright test",
		"test:e2e:docker": "bash tools/e2e-docker.sh",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:examples": "playwright test tests/examples.spec.js",
		"test:coverage": "c8 --reporter=html --reporter=text mocha ./test/bitwrench_ci.js -r jsdom-global/",
		"build:api-reference": "node tools/build-api-reference.js",
		"build:api-md": "node tools/build-api-markdown.js",
		"build:builds": "node tools/build-builds-manifest.js",
		"build:metrics": "node tools/build-metrics.cjs",
		"build:generated": "npm run sri && npm run build:readme && npm run build:api-reference && npm run build:api-md",
		"build:release": "npm run cleanbuild && npm run test && node tools/build-release.js",
		"release": "node tools/release.js",
		"release:dry": "node tools/release.js --dry-run",
		"start-release": "node tools/start-release.js",
		"test:bccl": "mocha ./test/bitwrench_test_bccl_contract.js ./test/bitwrench_test_semantic_html.js -r jsdom-global/register --exit",
		"sri": "npm run generate-sri && npm run build:builds && npm run verify-sri",
		"verify-sri": "node tools/verify-sri.js",
		"postbuild:css": "npm run sri",
		"test:golden": "mocha ./test/bitwrench_test_html_golden.js -r jsdom-global/register --exit",
		"test:contract": "mocha ./test/bitwrench_test_contract.js ./test/bitwrench_test_contract_live.js -r jsdom-global/register --exit"
	},
	"homepage": "https://deftio.github.io/bitwrench/pages",
	"overrides": {
		"mocha": {
			"serialize-javascript": "^7.0.3",
			"diff": "^8.0.3"
		}
	},
	"c8": {
		"all": true,
		"include": [
			"src/**"
		],
		"exclude": [
			"src/vendor/**",
			"src/**/*.d.ts",
			"src/bitwrench-esm-entry.js",
			"src/bitwrench-bccl-entry.js",
			"src/bitwrench-lean.js",
			"src/bitwrench-components-stub.js",
			"src/generate-css.js"
		],
		"check-coverage": true,
		"branches": 80,
		"lines": 80,
		"functions": 80,
		"statements": 80
	}
}
